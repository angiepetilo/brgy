# ============================================================
# .env.example — copy to .env and fill in real values
# NEVER commit the .env file to version control
# ============================================================

# ----- Core -----
# With DEBUG=False the app REFUSES TO START unless SECRET_KEY is set, is not the
# development default, is at least 50 characters, and ALLOWED_HOSTS is a
# non-empty list without '*'. Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-the-output-of-the-command-above
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ----- Database (MySQL/MariaDB in production) -----
DB_ENGINE=django.db.backends.mysql
DB_NAME=brgy_production
DB_USER=brgy_user
DB_PASSWORD=strong-db-password-here
DB_HOST=127.0.0.1
DB_PORT=3306

# ----- Email (SMTP via Gmail App Password or SMTP relay) -----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=example@gmail.com
EMAIL_HOST_PASSWORD=16 char
DEFAULT_FROM_EMAIL=Barangay e-Portal <systembrgy@gmail.com>
EMAIL_TIMEOUT=10

# ----- Admin error emails -----
ADMIN_EMAIL=admin@yourdomain.com
SERVER_EMAIL=noreply@yourdomain.com

# ----- Barangay identity -----
BARANGAY_NAME=Poblacion
BARANGAY_VENUE=Barangay Hall Multi-Purpose Center
BARANGAY_HEALTH_CENTER_VENUE=Barangay Health Center
BARANGAY_CONTACT=

# ----- HTTPS / cookies / HSTS -----
# When DEBUG=False these default to secure values; set them only to override.
# set False only if the proxy already redirects to HTTPS
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# 1 year; start lower (e.g. 3600) on a brand-new domain
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# manual opt-in at hstspreload.org; hard to undo
SECURE_HSTS_PRELOAD=False

# ----- Reverse proxy -----
# Number of reverse proxies (nginx, load balancer) in front of the app that
# append to X-Forwarded-For. 0 = ignore X-Forwarded-For and use REMOTE_ADDR.
# Behind one nginx with `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;` use 1.
# A wrong (too high) value lets clients fake their IP and dodge login lockouts.
TRUSTED_PROXY_COUNT=0

# ----- Content-Security-Policy -----
# True sends Content-Security-Policy-Report-Only (browser reports but does not block).
# Use it briefly when rolling out template changes; keep False (enforce) normally.
CSP_REPORT_ONLY=False

# ----- Login brute-force protection (shared 15-minute window) -----
# failures per username + IP before a lockout
LOGIN_FAILURE_LIMIT=5
# window and lockout length in seconds
LOGIN_LOCKOUT_SECONDS=900
# failures per IP across all usernames
LOGIN_IP_FAILURE_LIMIT=20
# failures per username across all IPs
LOGIN_USER_FAILURE_LIMIT=10

# ----- Rate limits: "<count>/<period>", period s, m, h or d (optionally 15m) -----
# per IP
RATE_LIMIT_PASSWORD_RESET=5/15m
# per IP
RATE_LIMIT_SIGNUP=5/h
# per user
RATE_LIMIT_PUBLIC_BOOKING=10/h
# per user (calls the external Abstract API)
RATE_LIMIT_EMAIL_VALIDATION=20/h
# per user (HTTP and WebSocket)
RATE_LIMIT_CHAT_SEND=30/m
RATE_LIMIT_STATISTICS_EXPORT=20/h
RATE_LIMIT_BLOTTER_CREATE=20/h

# ----- Retention (days) -----
REJECTED_REGISTRATION_RETENTION_DAYS=90
READ_NOTIFICATION_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365

# ----- Redis (optional; recommended in production) -----
# Used for the Channels layer AND the cache (rate-limit and login counters).
# Without it the cache is the database table brgy_cache_table
# (create it once with: python manage.py createcachetable).
# REDIS_URL=redis://127.0.0.1:6379/0
